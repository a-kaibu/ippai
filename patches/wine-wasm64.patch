+/***********************************************************************
+ *           KeUserModeCallback
+ *
+ * Runs KiUserCallbackDispatcher in a nested run loop until NtCallbackReturn.
+ */
+NTSTATUS KeUserModeCallback( ULONG id, const void *args, ULONG len, void **ret_ptr, ULONG *ret_len )
+{
+    struct thread_data *data = get_thread_data();
+    struct teb_data *teb_data = get_teb_data( data );
+    struct syscall_frame *frame = get_syscall_frame( data );
+    ULONG64 rsp = (frame->rsp - offsetof( struct callback_stack_layout, args_data[len] )) & ~15;
+    struct callback_stack_layout *stack = (struct callback_stack_layout *)(ULONG_PTR)rsp;
+    struct callback_result result = { 0 }, *prev_result = callback_result;
+    void *buffer = malloc( frame_size + 63 );
+    struct syscall_frame *cb_frame = (struct syscall_frame *)(((ULONG_PTR)buffer + 63) & ~63);
+    UINT64 saved[R_COUNT];
+
+    stack->args              = stack->args_data;
+    stack->len               = len;
+    stack->id                = id;
+    stack->machine_frame.rip = frame->rip;
+    stack->machine_frame.rsp = frame->rsp;
+    memcpy( stack->args_data, args, len );
+
+    vnhost_cpu_get64( thread_cpu, saved );
+    memset( cb_frame, 0, sizeof(*cb_frame) );
+    cb_frame->prev_frame = frame;
+    cb_frame->restore_flags = CONTEXT_CONTROL & 0xffff;
+    cb_frame->rsp = rsp;
+    cb_frame->rip = (ULONG64)pKiUserCallbackDispatcher;
+    cb_frame->eflags = 0x202;
+    cb_frame->xsave = frame->xsave;
+    teb_data->syscall_frame = cb_frame;
+    if (teb_data->syscall_trace) trace_usercall( id, (ULONG_PTR *)args, len );
+
+    callback_result = &result;
+    run_guest( data, &result );
+    callback_result = prev_result;
+
+    teb_data->syscall_frame = frame;
+    vnhost_cpu_set64( thread_cpu, saved );
+    free( buffer );
+    if (teb_data->syscall_trace) trace_userret( result.ret_ptr, result.ret_len, result.status, id );
+    *ret_ptr = result.ret_ptr;
+    *ret_len = result.ret_len;
+    return result.status;
+}
+
+
+/***********************************************************************
+ *           NtCallbackReturn  (NTDLL.@)
+ */
+NTSTATUS WINAPI NtCallbackReturn( void *ret_ptr, ULONG ret_len, NTSTATUS status )
+{
+    if (!callback_result) return STATUS_NO_CALLBACK_ACTIVE;
+    callback_result->ret_ptr = ret_ptr;
+    callback_result->ret_len = ret_len;
+    callback_result->status  = status;
+    callback_result->done    = TRUE;
+    return status;
+}
