+/***********************************************************************
+ *           frame <-> cpu
+ */
+static void save_cpu_to_frame( struct vnhost_cpu *cpu, struct syscall_frame *frame, BOOL fpu )
+{
+    UINT64 r[R_COUNT];
+
+    vnhost_cpu_get64( cpu, r );
+    frame->rax = r[R_RAX];
+    frame->rcx = r[R_RCX];
+    frame->rdx = r[R_RDX];
+    frame->rbx = r[R_RBX];
+    frame->rsp = r[R_RSP];
+    frame->rbp = r[R_RBP];
+    frame->rsi = r[R_RSI];
+    frame->rdi = r[R_RDI];
+    frame->r8  = r[R_R8];
+    frame->r9  = r[R_R9];
+    frame->r10 = r[R_R10];
+    frame->r11 = r[R_R11];
+    frame->r12 = r[R_R12];
+    frame->r13 = r[R_R13];
+    frame->r14 = r[R_R14];
+    frame->r15 = r[R_R15];
+    frame->rip = r[R_RIP];
+    frame->eflags = r[R_RFLAGS];
+    frame->cs = SEL_CS64;
+    frame->ss = SEL_DS64;
+    if (fpu)
+    {
+        vnhost_cpu_fxsave( cpu, &frame->xsave );
+        frame->xstate.Mask |= XSTATE_MASK_LEGACY;
+    }
+}
+
+/* load the guest state back after a syscall, as __wine_syscall_dispatcher_return does: the
+ * non-volatile registers always, the volatile ones only when a context was set */
+static void restore_cpu_from_frame( struct vnhost_cpu *cpu, struct syscall_frame *frame, UINT64 rax )
+{
+    UINT64 r[R_COUNT];
+    DWORD flags = frame->restore_flags;
+
+    vnhost_cpu_get64( cpu, r );
+    if (flags & CONTEXT_FLOATING_POINT & 0xffff) vnhost_cpu_fxrstor( cpu, &frame->xsave );
+    r[R_RBX] = frame->rbx;
+    r[R_RSI] = frame->rsi;
+    r[R_RDI] = frame->rdi;
+    r[R_RBP] = frame->rbp;
+    r[R_R12] = frame->r12;
+    r[R_R13] = frame->r13;
+    r[R_R14] = frame->r14;
+    r[R_R15] = frame->r15;
+    r[R_RAX] = rax;
+    if (flags & CONTEXT_INTEGER & 0xffff)
+    {
+        r[R_RAX] = frame->rax;
+        r[R_RCX] = frame->rcx;
+        r[R_RDX] = frame->rdx;
+        r[R_R8]  = frame->r8;
+        r[R_R9]  = frame->r9;
+        r[R_R10] = frame->r10;
+        r[R_R11] = frame->r11;
+    }
+    if (flags & (CONTEXT_CONTROL | CONTEXT_INTEGER) & 0xffff) r[R_RFLAGS] = frame->eflags;
+    r[R_RSP] = frame->rsp;
+    r[R_RIP] = frame->rip;
+    vnhost_cpu_set64( cpu, r );
+}
+
+
+/***********************************************************************
+ *           dispatch_syscall
+ *
+ * The guest called a syscall thunk: "mov r10,rcx; mov eax,id; ...; call [7ffe1000]; ret".
+ * The register arguments go into the caller's home space so that all of them are in a row.
+ */
+static void dispatch_syscall( struct thread_data *data, struct syscall_frame *frame, struct vnhost_cpu *cpu,
+                              BOOL instr )
+{
+    SYSTEM_SERVICE_TABLE *table;
+    UINT64 r[R_COUNT];
+    UINT id, num;
+    ULONG_PTR ret;
+    ULONG_PTR *args;
+
+    vnhost_cpu_get64( cpu, r );
+    save_cpu_to_frame( cpu, frame, TRUE );
+    frame->restore_flags = 0;
+    if (instr)
+    {
+        /* SYSCALL: RCX holds the return address, the caller's return address is at [rsp] */
+        frame->rip = r[R_RCX];
+        frame->rsp = r[R_RSP];
+        args = (ULONG_PTR *)(ULONG_PTR)(r[R_RSP] + 8);
+    }
+    else
+    {
+        frame->rip = *guest64( r[R_RSP] );   /* return address into the thunk */
+        frame->rsp = r[R_RSP] + 8;
+        args = (ULONG_PTR *)(ULONG_PTR)(r[R_RSP] + 16);
+    }
+    args[0] = r[R_R10];
+    args[1] = r[R_RDX];
+    args[2] = r[R_R8];
+    args[3] = r[R_R9];
+    id = (UINT)r[R_RAX];
+    frame->syscall_id = id;
+
+    table = (SYSTEM_SERVICE_TABLE *)get_teb_data( data )->syscall_table + ((id >> 12) & 3);
+    num = id & 0xfff;
+    if (num >= table->ServiceLimit || !table->ServiceTable) ret = STATUS_INVALID_SYSTEM_SERVICE;
+    else
+    {
+        ULONG_PTR (*func)( const ULONG_PTR * ) = (void *)table->ServiceTable[num];
+        if (get_teb_data( data )->syscall_trace) trace_syscall( id, args, table->ArgumentTable[num] );
+        ret = func( args );
+        if (get_teb_data( data )->syscall_trace) trace_sysret( id, ret );
+    }
+    restore_cpu_from_frame( cpu, frame, ret );
+}
+
+
+/***********************************************************************
+ *           dispatch_unix_call
+ *
+ * __wine_unix_call( unixlib_handle_t handle, unsigned int code, void *args ) jumped here:
+ * RCX, EDX, R8; [rsp] is the caller's return address.
+ */
+static void dispatch_unix_call( struct thread_data *data, struct syscall_frame *frame, struct vnhost_cpu *cpu )
+{
+    UINT64 r[R_COUNT];
+    NTSTATUS ret;
+    const unixlib_entry_t *funcs;
+
+    vnhost_cpu_get64( cpu, r );
+    save_cpu_to_frame( cpu, frame, FALSE );
+    frame->restore_flags = RESTORE_FLAGS_INCOMPLETE_FRAME_CONTEXT;
+    frame->rip = *guest64( r[R_RSP] );
+    frame->rsp = r[R_RSP] + 8;
+    funcs = (const unixlib_entry_t *)(ULONG_PTR)r[R_RCX];
+    if (funcs) ret = funcs[(UINT)r[R_RDX]]( (void *)(ULONG_PTR)r[R_R8] );
+    else
+    {
+        WARN( "unix call %u without a unix library\n", (UINT)r[R_RDX] );
+        ret = STATUS_DLL_NOT_FOUND;
+    }
+    restore_cpu_from_frame( cpu, frame, (UINT)ret );
+}
+
+
+/***********************************************************************
+ *           raise_guest_exception
+ */
+static void raise_guest_exception( struct thread_data *data, struct syscall_frame *frame,
+                                   struct vnhost_cpu *cpu, int exit, const UINT *info )
+{
+    EXCEPTION_RECORD rec = { 0 };
+    CONTEXT context = { CONTEXT_FULL };
+    NTSTATUS status;
+
+    save_cpu_to_frame( cpu, frame, TRUE );
+    frame->restore_flags = 0;
+    NtGetContextThread( GetCurrentThread(), &context );
+
+    rec.ExceptionAddress = (void *)frame->rip;
+    switch (exit)
+    {
+    case VNHOST_FAULT:
+        rec.ExceptionCode = STATUS_ACCESS_VIOLATION;
+        rec.NumberParameters = 2;
+        rec.ExceptionInformation[0] = info[1] ? EXCEPTION_WRITE_FAULT : EXCEPTION_READ_FAULT;
+        rec.ExceptionInformation[1] = info[0];
+        break;
+    case VNHOST_DIVIDE:
+        rec.ExceptionCode = EXCEPTION_INT_DIVIDE_BY_ZERO;
+        break;
+    case VNHOST_INT:
+        if (info[0] == 3)
+        {
+            rec.ExceptionCode = EXCEPTION_BREAKPOINT;
+            rec.NumberParameters = 1;
+            rec.ExceptionAddress = (char *)rec.ExceptionAddress - 1;
+            break;
+        }
+        if (info[0] == 0x2d)
+        {
+            rec.ExceptionCode = EXCEPTION_BREAKPOINT;
+            rec.NumberParameters = 1;
+            rec.ExceptionInformation[0] = context.Rax;
+            break;
+        }
+        if (info[0] == 0x29) /* __fastfail */
+        {
+            rec.ExceptionCode = STATUS_STACK_BUFFER_OVERRUN;
+            rec.ExceptionFlags = EXCEPTION_NONCONTINUABLE;
+            rec.NumberParameters = 1;
+            rec.ExceptionInformation[0] = context.Rcx;
+            break;
+        }
+        rec.ExceptionCode = STATUS_ACCESS_VIOLATION;
+        rec.NumberParameters = 2;
+        rec.ExceptionInformation[1] = ~(ULONG_PTR)0;
+        break;
+    case VNHOST_HALT:
+        rec.ExceptionCode = STATUS_PRIVILEGED_INSTRUCTION;
+        break;
+    default:
+        rec.ExceptionCode = EXCEPTION_ILLEGAL_INSTRUCTION;
+        break;
+    }
+
+    status = send_debug_event( data, &rec, &context, TRUE );
+    if (status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED)
+    {
+        NtSetContextThread( GetCurrentThread(), &context );
+        restore_cpu_from_frame( cpu, frame, frame->rax );
+        return;
+    }
+    call_user_exception_dispatcher( data, &rec, &context );
+    frame->restore_flags |= CONTEXT_CONTROL;
+    restore_cpu_from_frame( cpu, frame, frame->rax );
+}
+
+
+/***********************************************************************
+ *           handle_pending_signals
+ */
+static void handle_pending_signals( struct syscall_frame *frame, struct vnhost_cpu *cpu )
+{
+    if (vnhost_signal_pending( SIGUSR1 ))
+    {
+        CONTEXT context = { CONTEXT_FULL };
+
+        save_cpu_to_frame( cpu, frame, TRUE );
+        frame->restore_flags = 0;
+        NtGetContextThread( GetCurrentThread(), &context );
+        wait_suspend( &context );
+        NtSetContextThread( GetCurrentThread(), &context );
+        frame->restore_flags |= CONTEXT_FULL;
+        restore_cpu_from_frame( cpu, frame, frame->rax );
+    }
+    if (vnhost_signal_pending( SIGQUIT )) abort_thread( 0 );
+}
+
+
+/***********************************************************************
+ *           run_loop
+ */
+static void run_loop( struct thread_data *data, struct callback_result *result )
+{
+    struct vnhost_cpu *cpu = thread_cpu;
+    UINT info[2];
+
+    for (;;)
+    {
+        struct syscall_frame *frame = get_syscall_frame( data );
+        int exit = vnhost_cpu_run( cpu, info );
+
+        switch (exit)
+        {
+        case VNHOST_TRAP:
+            if (info[0] == WASM_SYSCALL_TRAP) dispatch_syscall( data, frame, cpu, FALSE );
+            else if (info[0] == WASM_UNIXCALL_TRAP) dispatch_unix_call( data, frame, cpu );
+            else raise_guest_exception( data, frame, cpu, VNHOST_FAULT, info );
+            break;
+        case VNHOST_SYSCALL:
+            dispatch_syscall( data, frame, cpu, TRUE );
+            break;
+        case VNHOST_PENDING:
+            handle_pending_signals( frame, cpu );
+            break;
+        default:
+            raise_guest_exception( data, frame, cpu, exit, info );
+            break;
+        }
+        if (result && result->done) return;
+    }
+}
+
+static void run_guest( struct thread_data *data, struct callback_result *result )
+{
+    restore_cpu_from_frame( thread_cpu, get_syscall_frame( data ), get_syscall_frame( data )->rax );
+    run_loop( data, result );
+}
