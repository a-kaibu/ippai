+/*
+ * wasm signal and syscall layer for x86-64 guests (vnvm Hangover-style runtime)
+ *
+ * The 64-bit build of the unix side (emscripten -sMEMORY64=2: LP64 like Wine's x86_64 unix
+ * side, in the same 32-bit linear memory as the guest) runs x86_64 PE code in the x86 core
+ * (vnx86 in long mode). All guest memory is below 4GB. Syscall thunks reach the unix side
+ * through "call [0x7ffe1000]" (SystemCall = 1 in the shared user data), which holds
+ * WASM_SYSCALL_TRAP; __wine_unix_call jumps through __wine_unix_call_dispatcher, which holds
+ * WASM_UNIXCALL_TRAP. The guest register state is kept in the syscall frame exactly like on
+ * x86_64, so the generic context, APC and exception code works unchanged.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#if defined(__wasm__) && defined(__x86_64__)
+
