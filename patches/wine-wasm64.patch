+/**********************************************************************
+ *		signal_init_process
+ */
+void signal_init_process( TEB *teb )
+{
+    void *ptr;
+
+    if (user_shared_data->XState.Size) xstate_size = user_shared_data->XState.Size - sizeof(XSAVE_FORMAT);
+    frame_size = (offsetof( struct syscall_frame, xstate ) + sizeof(XSAVE_AREA_HEADER) + xstate_size + 63) & ~63;
+    alloc_syscall_frame( frame_size );
+
+    /* the syscall thunks call through a pointer at a fixed address (7ffe1000) */
+    ptr = (char *)user_shared_data + page_size;
+    anon_mmap_fixed( ptr, page_size, PROT_READ | PROT_WRITE, 0 );
+    *(ULONG64 *)ptr = WASM_SYSCALL_TRAP;
+
+    signal_alloc_thread( teb );
+}
+
+
+/***********************************************************************
+ *           init_syscall_frame
+ */
+static void init_syscall_frame( PRTL_THREAD_START_ROUTINE entry, void *arg, TEB *teb )
+{
+    struct thread_data *data = get_thread_data();
+    struct syscall_frame *frame = get_syscall_frame( data );
+    CONTEXT *ctx, context = { 0 };
+
+    context.ContextFlags = CONTEXT_ALL | CONTEXT_EXCEPTION_REPORTING | CONTEXT_EXCEPTION_ACTIVE;
+    context.Rcx    = (ULONG_PTR)entry;
+    context.Rdx    = (ULONG_PTR)arg;
+    context.Rsp    = (ULONG_PTR)teb->Tib.StackBase - 0x28;
+    context.Rip    = (ULONG_PTR)pRtlUserThreadStart;
+    context.SegCs  = SEL_CS64;
+    context.SegDs  = SEL_DS64;
+    context.SegEs  = SEL_DS64;
+    context.SegFs  = SEL_FS32;
+    context.SegGs  = SEL_DS64;
+    context.SegSs  = SEL_DS64;
+    context.EFlags = 0x200;
+    context.FltSave.ControlWord = 0x27f;
+    context.FltSave.MxCsr = context.MxCsr = 0x1f80;
+
+    if (data->suspend) wait_suspend( &context );
+
+    ctx = (CONTEXT *)((ULONG_PTR)context.Rsp & ~15) - 1;
+    *ctx = context;
+    ctx->ContextFlags = CONTEXT_FULL | CONTEXT_FLOATING_POINT;
+    memset( &frame->xstate, 0, sizeof(frame->xstate) );
+    signal_set_full_context( ctx );
+
+    frame->cs  = SEL_CS64;
+    frame->ss  = SEL_DS64;
+    frame->rsp = (ULONG64)ctx - 8;
+    frame->rip = (ULONG64)pLdrInitializeThunk;
+    frame->rcx = (ULONG64)ctx;
+    frame->restore_flags |= CONTEXT_CONTROL | CONTEXT_INTEGER | CONTEXT_FLOATING_POINT;
+
+    pthread_sigmask( SIG_UNBLOCK, &server_block_set, NULL );
+}
+
+
+/***********************************************************************
+ *           signal_start_thread
+ */
+void DECLSPEC_NORETURN signal_start_thread( PRTL_THREAD_START_ROUTINE entry, void *arg, TEB *teb )
+{
+    struct thread_data *data = get_thread_data();
+    struct teb_data *teb_data = get_teb_data( data );
+    void *buffer = NULL;
+
+    if (!teb_data->syscall_frame)
+    {
+        buffer = malloc( frame_size + 63 );
+        teb_data->syscall_frame = (void *)(((ULONG_PTR)buffer + 63) & ~63);
+        memset( teb_data->syscall_frame, 0, sizeof(struct syscall_frame) );
+    }
+    thread_cpu = vnhost_cpu_create( WASM_SYSCALL_TRAP, WASM_TRAP_END );
+    vnhost_cpu_set_long_mode( thread_cpu, (UINT)(ULONG_PTR)teb );
+
+    init_syscall_frame( entry, arg, teb );
+    run_guest( data, NULL );
+    abort();
+}
