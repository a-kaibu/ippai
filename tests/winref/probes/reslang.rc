/* resources of the reslang probe: the same string ids and RCDATA names in several languages,
 * in the order a linker sorts them (0x404 first), as 虜ノ焔 体験版's launcher has them */
#include <windows.h>
1 24 "ja.manifest"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL
STRINGTABLE { 100 "zh-TW" 200 "zh-TW only" }
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE { 100 "en-US" 200 "en-US" }
LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
STRINGTABLE { 100 "ja-JP" }
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
STRINGTABLE { 100 "zh-CN" 200 "zh-CN" 300 "zh-CN" }

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL
ALL4 RCDATA { "zh-TW\0" }
NOJA RCDATA { "zh-TW\0" }
ZHONLY RCDATA { "zh-TW\0" }
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
ALL4 RCDATA { "en-US\0" }
NOJA RCDATA { "en-US\0" }
LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
ALL4 RCDATA { "ja-JP\0" }
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
ALL4 RCDATA { "zh-CN\0" }
NOJA RCDATA { "zh-CN\0" }
ZHONLY RCDATA { "zh-CN\0" }
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
NEUTRAL RCDATA { "neutral\0" }
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
NEUTRAL RCDATA { "en-US\0" }
